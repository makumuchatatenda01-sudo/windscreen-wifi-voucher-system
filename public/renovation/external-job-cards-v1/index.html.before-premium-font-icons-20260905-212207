<script>
const track=document.getElementById('track');const slides=[...document.querySelectorAll('.slide')];const dots=document.getElementById('dots');const label=document.getElementById('countLabel');let current=0;
slides.forEach((s,i)=>{const b=document.createElement('button');b.className='dot'+(i===0?' active':'');b.setAttribute('aria-label',`Go to ${s.dataset.title}`);b.onclick=()=>go(i);dots.appendChild(b)});
function go(i){current=Math.max(0,Math.min(i,slides.length-1));slides[current].scrollIntoView({behavior:'smooth',block:'start'});}
document.getElementById('prev').onclick=()=>go(current-1);document.getElementById('next').onclick=()=>go(current+1);document.addEventListener('keydown',e=>{if(e.key==='ArrowLeft')go(current-1);if(e.key==='ArrowRight')go(current+1)});
const toast=document.getElementById('toast');let toastTimer;document.addEventListener('click',e=>{const t=e.target.closest('[data-toast]');if(t){toast.textContent=t.dataset.toast;toast.classList.add('show');clearTimeout(toastTimer);toastTimer=setTimeout(()=>toast.classList.remove('show'),1800)}});
document.querySelectorAll('.toggle').forEach(t=>t.addEventListener('click',e=>{if(e.target.tagName==='BUTTON'){[...t.children].forEach(b=>b.classList.remove('active'));e.target.classList.add('active')}}));
document.querySelectorAll('.filters').forEach(f=>f.addEventListener('click',e=>{if(e.target.tagName==='BUTTON'){[...f.children].forEach(b=>b.classList.remove('active'));e.target.classList.add('active')}}));
document.querySelectorAll('.record').forEach(r=>r.addEventListener('click',()=>{document.querySelectorAll('.record').forEach(x=>x.classList.remove('active'));r.classList.add('active')}));
const search=document.getElementById('recordSearch');if(search)search.addEventListener('input',e=>{const q=e.target.value.toLowerCase();document.querySelectorAll('.record').forEach(r=>r.style.display=r.dataset.name.toLowerCase().includes(q)?'grid':'none')});
</script>
