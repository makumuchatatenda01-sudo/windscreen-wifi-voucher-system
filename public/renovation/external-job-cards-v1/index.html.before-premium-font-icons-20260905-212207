<body>
<div class="app">
  <header class="topbar shell">
    <div class="brand"><small>Windscreen Fitment Centre</small><h1>External Job Cards</h1><p>Capture, review and process external job cards from authorised staff.</p></div>
    <div class="status"><div class="online"><i></i>Automation online</div><div class="avatar">WF</div></div>
  </header>

  <main class="carousel" id="carousel">
    <div class="track" id="track">
      <section class="slide active" data-title="Manual Intake">
        <div class="slide-inner">
          <div class="metrics">
            <article class="card metric total"><div class="metric-icon"><svg viewBox="0 0 24 24"><rect x="5" y="4" width="14" height="17" rx="2"/><path d="M9 4V2h6v2M9 9h6M9 13h6M9 17h4"/></svg></div><div><label>Total Job Cards</label><strong>157</strong><small>received from staff</small></div></article>
            <article class="card metric review"><div class="metric-icon"><svg viewBox="0 0 24 24"><path d="M12 3 2.8 19h18.4L12 3Z"/><path d="M12 9v4M12 17h.01"/></svg></div><div><label>Needs Review</label><strong>6</strong><small>waiting for staff</small></div></article>
            <article class="card metric ready"><div class="metric-icon"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="m8.5 12 2.3 2.3 4.8-5"/></svg></div><div><label>Ready</label><strong>1</strong><small>complete and approved</small></div></article>
            <article class="card metric submitted"><div class="metric-icon"><svg viewBox="0 0 24 24"><path d="M14 4h6v6M20 4l-9 9"/><path d="M11 6H5a2 2 0 0 0-2 2v11a2 2 0 0 0 2 2h11a2 2 0 0 0 2-2v-6"/></svg></div><div><label>Submitted</label><strong>149</strong><small>sent to Keith Tech</small></div></article>
          </div>
          <section class="card section-card manual">
            <div class="manual-head"><div><div class="kicker">Manual Intake</div><h2>Paste an external job card</h2><p class="sub">WhatsApp job cards from authorised staff arrive automatically. Use this for manual entry when needed.</p></div><div class="visible"><i></i>157 visible</div></div>
            <textarea placeholder="Paste the complete WINDSCREEN JOB CARD text here..."></textarea>
            <div class="manual-actions"><div class="action-group"><button class="btn" data-toast="Preview extraction prepared"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12Z"/><circle cx="12" cy="12" r="2.5"/></svg>Preview Extraction</button><button class="btn primary" data-toast="Added to review inbox"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 7h16v12H4z"/><path d="M4 12h5l2 2h2l2-2h5"/></svg>Add to Review Inbox</button></div><div class="security-note"><span>ⓘ</span>Job cards are processed securely and automatically.</div></div>
          </section>
        </div>
      </section>

      <section class="slide" data-title="Inbox & Summary">
        <div class="slide-inner">
          <div class="metrics">
            <article class="card metric total"><div class="metric-icon"><svg viewBox="0 0 24 24"><rect x="5" y="4" width="14" height="17" rx="2"/><path d="M9 4V2h6v2M9 9h6M9 13h6M9 17h4"/></svg></div><div><label>Total Job Cards</label><strong>157</strong><small>received from staff</small></div></article>
            <article class="card metric review"><div class="metric-icon"><svg viewBox="0 0 24 24"><path d="M12 3 2.8 19h18.4L12 3Z"/><path d="M12 9v4M12 17h.01"/></svg></div><div><label>Needs Review</label><strong>6</strong><small>waiting for staff</small></div></article>
            <article class="card metric ready"><div class="metric-icon"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="m8.5 12 2.3 2.3 4.8-5"/></svg></div><div><label>Ready</label><strong>1</strong><small>complete and approved</small></div></article>
            <article class="card metric submitted"><div class="metric-icon"><svg viewBox="0 0 24 24"><path d="M14 4h6v6M20 4l-9 9"/><path d="M11 6H5a2 2 0 0 0-2 2v11a2 2 0 0 0 2 2h11a2 2 0 0 0 2-2v-6"/></svg></div><div><label>Submitted</label><strong>149</strong><small>sent to Keith Tech</small></div></article>
